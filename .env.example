# Safe local-only defaults. Copy to .env.local; do not commit real values.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
SETUP_MODE=disabled
DB_DRIVER=sqlite
DATABASE_PATH=./data/lifemaxing.sqlite
# Vercel only: DB_DRIVER=libsql plus DATABASE_URL, DATABASE_AUTH_TOKEN,
# DATABASE_ENVIRONMENT=preview|production, and an HTTPS APP_ORIGIN.
AI_MODE=disabled
NEXT_TELEMETRY_DISABLED=1
